<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Payment Successful</title>
  <style>
    body { background-color: #f8f8f8; font-family: Arial, sans-serif; margin: 0; padding: 0; }
    .email-container { background-color: #ffffff; margin: 0 auto; padding: 20px; max-width: 600px; }
    .header { text-align: center; padding: 20px; }
    .header img { max-width: 150px; }
    .content { margin: 20px 0; }
    .content h2 { color: #333333; }
    .button { background-color: #007bff; color: #ffffff; padding: 12px 20px; text-decoration: none; border-radius: 4px; }
    .footer { font-size: 12px; text-align: center; color: #777777; margin-top: 20px; }
  </style>
</head>
<body>
  <div class="email-container">
    <div class="header">
      <img src="{{logoUrl}}" alt="DMAN E-commerce">
    </div>
    <div class="content">
      <h2>{{title}}</h2>
      <p>{{message}}</p>
      <p><strong>Transaction Reference:</strong> {{reference}}</p>
      <p><strong>Order ID:</strong> {{orderId}}</p>
      <p><a href="{{orderLink}}" class="button">View Your Order</a></p>
    </div>
    <div class="footer">
      <p>DMAN E-commerce • Your Company Address • Contact Info</p>
      <p>If you have any questions, reply to this email or contact our support.</p>
    </div>
  </div>
</body>
</html>
